# Launch workshop.ino via Docker Compose as a service.
#
# Install:
#   Edit the "user:" attribute in docker-compose.yaml to match the user/group that will own files created by the app
#   Edit WorkingDirectory to match the docker-compose.yaml file and contents location
#   sudo cp deploy/docker/workshop.ino.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now workshop.ino
#
# Logs: journalctl -u workshop.ino -f

[Unit]
Description=workshop.ino — live workshop lab handbook (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/arduino/workshop.ino
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
